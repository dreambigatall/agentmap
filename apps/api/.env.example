# Copy this file to .env and fill in the values. Never commit .env.

# Supabase > Project Settings > Database > Connection string.
# Use the pooler host (<region>.pooler.supabase.com) for both lines. The direct host
# (db.<project-ref>.supabase.co) is IPv6-only and many networks cannot reach it.
# connect_timeout=30 allows for slow networks; a new connection can take a few seconds.
# schema=app keeps our tables out of "public", which Supabase publishes through its REST API.

# Transaction pooler, port 6543. Used by the running API.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=30&schema=app"
# Session pooler, port 5432. Used for migrations and the job queue.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?connect_timeout=30&schema=app"

API_PORT=4000
# The address of the web app, allowed to call this API from the browser.
WEB_ORIGIN="http://localhost:3000"

# Signs session tokens. Long and random; different in every environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Address of the web app, used in links inside emails.
APP_URL="http://localhost:3000"

# Sender for emails. Leave RESEND_API_KEY empty in development: emails are printed to the API log instead.
MAIL_FROM="Skillflow <onboarding@resend.dev>"
# Resend API key (resend.com). Empty means emails are only logged.
RESEND_API_KEY=""
