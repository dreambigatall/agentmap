// Database schema for Skillflow.
// PostgreSQL hosted on Supabase, used as plain Postgres.
//
// All tables live in the "app" schema, set by ?schema=app in the connection strings.
// Supabase publishes the "public" schema through its REST API to anyone holding the
// project's anon key, so nothing of ours goes there.
//
// Tables are added phase by phase; see the Build plan, section 4.
// Naming: models are PascalCase in code, tables and columns snake_case in Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- Phase 1: core

/// What a member may do in a workspace. Order matters: reviewer < editor < admin < owner.
enum MemberLevel {
  reviewer
  editor
  admin
  owner

  @@map("member_level")
}

enum AuthTokenType {
  email_verification
  password_reset

  @@map("auth_token_type")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Stored lower-case and trimmed; unique across the product.
  email           String    @unique
  name            String
  /// Empty for accounts that only sign in with Google.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  authTokens        AuthToken[]
  invitesSent       Invite[]         @relation("InvitedBy")
  skillVersions     SkillVersion[]
  requests          Request[]        @relation("RequestAuthor")
  requestVersions   RequestVersion[]
  filesUploaded     StoredFile[]
  comments          Comment[]        @relation("CommentAuthor")
  commentsResolved  Comment[]        @relation("CommentResolver")
  signoffsRequested Signoff[]        @relation("SignoffRequester")
  signoffsOwned     Signoff[]        @relation("SignoffOwner")
  notifications     Notification[]   @relation("NotificationRecipient")
  notificationsSent Notification[]   @relation("NotificationActor")

  @@map("users")
}

/// One row per issued refresh token. Tokens rotate on every use; all tokens from one
/// sign-in share a family, and reuse of a spent token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Single-use links sent by email: verify an address, reset a password.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Used in web addresses: /w/<slug>/...
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  invites         Invite[]
  roles           Role[]
  channels        Channel[]
  agents          Agent[]
  capabilities    Capability[]
  skills          Skill[]
  skillSteps      SkillStep[]
  skillInputs     SkillInput[]
  skillChannels   SkillChannel[]
  skillVersions   SkillVersion[]
  requests        Request[]
  requestSteps    RequestStep[]
  requestInputs   RequestInput[]
  requestVersions RequestVersion[]
  files           StoredFile[]
  comments        Comment[]
  signoffs        Signoff[]
  notifications   Notification[]

  @@map("workspaces")
}

/// A person's place in a workspace. Exactly one owner per workspace is enforced by a
/// partial unique index written by hand in the first migration.
model Membership {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  level       MemberLevel
  lastSeenAt  DateTime?   @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invite {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  /// Stored lower-case and trimmed.
  email       String
  level       MemberLevel
  tokenHash   String      @unique @map("token_hash")
  invitedById String      @map("invited_by_id") @db.Uuid
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?   @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
  @@map("invites")
}

// ------------------------------------------------- Phase 2: agents and skills
// Every table below carries workspace_id and is listed in WORKSPACE_MODELS
// (src/prisma/prisma.service.ts), so the scoped client filters it automatically.

/// A human job that can perform a step, e.g. "Line manager". Each workspace keeps its own list.
/// Not the same as a member's permission level: a role need not be a member at all.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps        SkillStep[]
  startsSkills Skill[]       @relation("StartedBy")
  requestSteps RequestStep[]

  @@unique([workspaceId, name])
  @@map("roles")
}

/// Where an agent talks to people, e.g. "Email" or "Slack".
model Channel {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skills    SkillChannel[]

  @@unique([workspaceId, name])
  @@map("channels")
}

model Agent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// Badge text, up to 6 characters, e.g. "PLA".
  shortName   String    @map("short_name")
  fullName    String    @map("full_name")
  description String    @default("")
  color       String
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capabilities Capability[]
  requests     Request[]

  @@index([workspaceId])
  @@map("agents")
}

/// A named group of skills inside one agent, e.g. "KPI planning".
model Capability {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  agentId     String    @map("agent_id") @db.Uuid
  name        String
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skills    Skill[]

  @@index([agentId])
  @@map("capabilities")
}

enum SkillStatus {
  draft
  defined
  in_build
  live

  @@map("skill_status")
}

/// One workflow an agent performs, from what starts it to what it delivers.
model Skill {
  id              String      @id @default(uuid()) @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  capabilityId    String      @map("capability_id") @db.Uuid
  name            String
  status          SkillStatus @default(draft)
  /// Empty means the agent starts the skill by itself.
  startedByRoleId String?     @map("started_by_role_id") @db.Uuid
  trigger         String      @default("")
  deliverable     String      @default("")
  humanControl    String      @default("") @map("human_control")
  /// Applies alongside every other skill in the capability, e.g. approval rules.
  runsAlongside   Boolean     @default(false) @map("runs_alongside")
  sortOrder       Int         @default(0) @map("sort_order")
  /// Goes up by one on every save. A save based on an older number is refused.
  version         Int         @default(1)
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capability Capability     @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  startedBy  Role?          @relation("StartedBy", fields: [startedByRoleId], references: [id], onDelete: SetNull)
  steps      SkillStep[]
  inputs     SkillInput[]
  channels   SkillChannel[]
  versions   SkillVersion[]
  signoffs   Signoff[]
  requests   Request[]

  @@index([capabilityId])
  @@map("skills")
}

/// One action in a skill, done by the agent (role empty) or by one human role.
/// Ids stay the same across saves, so comments on a step survive reordering.
model SkillStep {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  skillId     String  @map("skill_id") @db.Uuid
  position    Int
  roleId      String? @map("role_id") @db.Uuid
  text        String
  isApproval  Boolean @default(false) @map("is_approval")
  /// What happens when an approval is refused.
  ifNo        String  @default("") @map("if_no")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([skillId, position])
  @@map("skill_steps")
}

enum InputNeed {
  automatic
  required

  @@map("input_need")
}

/// Information the skill needs: fetched automatically, or required from a person.
model SkillInput {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  skillId     String    @map("skill_id") @db.Uuid
  position    Int
  label       String
  need        InputNeed

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, position])
  @@map("skill_inputs")
}

model SkillChannel {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  skillId     String @map("skill_id") @db.Uuid
  channelId   String @map("channel_id") @db.Uuid
  /// One line on how the agent uses this channel in this skill.
  usage       String @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([skillId, channelId])
  @@map("skill_channels")
}

/// A full copy of a skill as it was after one save. Never changed or deleted.
model SkillVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  number      Int
  snapshot    Json
  /// What changed, in words, e.g. "Changed steps: 1 added".
  note        String
  authorId    String?  @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([skillId, number])
  @@map("skill_versions")
}

// ------------------------------------------------- Phase 4: requests, comments, sign-off

enum RequestStatus {
  new
  in_review
  approved
  declined

  @@map("request_status")
}

enum RequestFrequency {
  daily
  weekly
  monthly
  quarterly
  when_needed

  @@map("request_frequency")
}

/// How a piece of work is done today, described by the people who do it.
/// An approved request can be turned into a draft skill.
model Request {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  agentId     String            @map("agent_id") @db.Uuid
  name        String
  status      RequestStatus     @default(new)
  /// What starts the work today, and who starts it.
  trigger     String            @default("")
  /// The role accountable for the work, in the author's words.
  ownerRole   String            @default("") @map("owner_role")
  frequency   RequestFrequency?
  result      String            @default("")
  rules       String            @default("")
  problems    String            @default("")
  /// Decisions or steps that should never be automated.
  keepHuman   String            @default("") @map("keep_human")
  authorId    String            @map("author_id") @db.Uuid
  /// The skill this request became, once converted.
  skillId     String?           @map("skill_id") @db.Uuid
  version     Int               @default(1)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  author    User             @relation("RequestAuthor", fields: [authorId], references: [id])
  skill     Skill?           @relation(fields: [skillId], references: [id], onDelete: SetNull)
  steps     RequestStep[]
  inputs    RequestInput[]
  versions  RequestVersion[]
  files     StoredFile[]

  @@index([agentId])
  @@map("requests")
}

/// One step of today's process. The actor is a workspace role, or free text when
/// the author picked "someone else".
model RequestStep {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  requestId   String  @map("request_id") @db.Uuid
  position    Int
  roleId      String? @map("role_id") @db.Uuid
  otherRole   String  @default("") @map("other_role")
  action      String
  /// Where it happens: a system, a meeting, a spreadsheet.
  place       String  @default("")
  isApproval  Boolean @default(false) @map("is_approval")
  ifNo        String  @default("") @map("if_no")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([requestId, position])
  @@map("request_steps")
}

/// Information or a document someone provides along the way.
model RequestInput {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  requestId   String @map("request_id") @db.Uuid
  position    Int
  what        String
  who         String @default("")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  files     StoredFile[]

  @@index([requestId, position])
  @@map("request_inputs")
}

model RequestVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  number      Int
  snapshot    Json
  note        String
  authorId    String?  @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([requestId, number])
  @@map("request_versions")
}

/// An uploaded file, stored in Postgres. Up to 10 MB each; the workspace total is capped.
/// `data` is only ever selected by the download route.
model StoredFile {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  requestInputId String?  @map("request_input_id") @db.Uuid
  name           String
  mimeType       String   @map("mime_type")
  size           Int
  data           Bytes
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request      Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestInput RequestInput? @relation(fields: [requestInputId], references: [id], onDelete: SetNull)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([workspaceId])
  @@map("files")
}

enum CommentTarget {
  skill
  request

  @@map("comment_target")
}

/// A note on a skill or a request, optionally on one of its steps.
/// stepId is not a foreign key: a comment outlives the step it was on.
model Comment {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  targetType       CommentTarget @map("target_type")
  targetId         String        @map("target_id") @db.Uuid
  stepId           String?       @map("step_id") @db.Uuid
  body             String
  mentionedUserIds String[]      @default([]) @map("mentioned_user_ids") @db.Uuid
  authorId         String        @map("author_id") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedById     String?       @map("resolved_by_id") @db.Uuid
  editedAt         DateTime?     @map("edited_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author     User      @relation("CommentAuthor", fields: [authorId], references: [id])
  resolvedBy User?     @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@map("comments")
}

enum SignoffStatus {
  pending
  approved
  changes_asked
  cancelled
  /// The skill changed after the sign-off was asked or given.
  outdated

  @@map("signoff_status")
}

/// A business owner's decision on one exact version of a skill.
model Signoff {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  skillId       String        @map("skill_id") @db.Uuid
  skillVersion  Int           @map("skill_version")
  status        SignoffStatus @default(pending)
  requestedById String        @map("requested_by_id") @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  /// The owner's reason when asking for changes, optional when approving.
  note          String        @default("")
  decidedAt     DateTime?     @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("SignoffRequester", fields: [requestedById], references: [id])
  owner       User      @relation("SignoffOwner", fields: [ownerId], references: [id])

  @@index([skillId])
  @@index([ownerId, status])
  @@map("signoffs")
}

/// Something a person should know about, shown in the bell and often emailed.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  kind        String
  text        String
  /// A path inside the web app, e.g. /w/acme/skills/123.
  link        String
  actorId     String?   @map("actor_id") @db.Uuid
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, workspaceId, createdAt])
  @@map("notifications")
}
